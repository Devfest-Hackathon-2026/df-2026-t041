# --- AI (server-side only; never exposed to the browser) ---
# Without any of these the app still works fully with the built-in (non-AI) design generator.
#
# Option A: Gemini Developer API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Option B: Gemini on Vertex AI using the runtime service account (no key; used on Cloud Run)
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Optional fallback provider: used automatically when Gemini fails (quota, overload, timeout)
OPENAI_API_KEY=
# Optional: force one provider (gemini | openai) and disable fallback
AI_PROVIDER=
# Optional model overrides
GEMINI_MODEL=gemini-3-flash-preview
OPENAI_MODEL=gpt-6.1-terra
# Optional per-request AI timeout in ms (default 45000)
AI_TIMEOUT_MS=
